{
  "name": "tracy-domain",
  "main": "edge.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tracys.online", "custom_domain": true }]
  // Before deployment, set DAYTONA_ORIGIN to the actual HTTPS preview origin for port 8000.
  // Store DAYTONA_PREVIEW_TOKEN with `wrangler secret put`; never put it here or in Git.
}
