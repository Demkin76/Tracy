[Unit]
Description=Tracy website, API and paper strategy worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/tracy/data/configured

[Service]
User=tracy
Group=tracy
WorkingDirectory=/opt/tracy
ExecStart=/opt/tracy/.venv/bin/python -m uvicorn deploy.server.app:create_app --factory --host 127.0.0.1 --port 8108 --workers 1 --no-proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tracy/data
MemoryMax=1G
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
