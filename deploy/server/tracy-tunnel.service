[Unit]
Description=Tracy backend private Cloudflare Tunnel
After=network-online.target tracy-backend.service

[Service]
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --metrics 127.0.0.1:20248 run --token-file %h/tracy-backend/data/tunnel-token
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
MemoryMax=256M

[Install]
WantedBy=default.target
