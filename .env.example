# Run: python -m scripts.setup_mvp (only when .env does not exist).
# Base64 encoded 32-byte Ed25519 seeds. Never commit actual keys.
POA_SIGNING_SEED=
POA_EXECUTION_WALLET_SEED=
POA_RPC_URL=https://api.devnet.solana.com
POA_ADAPTIVE_DEVNET_ANCHORS_ENABLED=false
POA_VERIFICATION_RPC_URL=https://api.devnet.solana.com
POA_DATABASE_PATH=data/tracy-mvp.sqlite3
POA_DEVNET_ENABLED=false
POA_SIGNUP_ENABLED=true
POA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Use true behind HTTPS. False is for local HTTP only.
POA_COOKIE_SECURE=false
POA_SESSION_SECONDS=604800
POA_RECONCILER_ENABLED=true
POA_RECONCILIATION_INTERVAL_SECONDS=5
POA_OWNER_DAILY_LAMPORTS=1000000000
POA_PLATFORM_DAILY_LAMPORTS=5000000000
POA_EXECUTION_ENABLED=true

POA_CONTROL_RESOURCES_PATH=data/mvp-resources.json
POA_CONTROL_CREDENTIALS_PATH=data/mvp-credentials.json

# Optional Copilot; keep the actual key private. Built-in guide works without this.
# POA_COPILOT_API_KEY=
# POA_COPILOT_MODEL=gpt-4o-mini

# Gemini is preferred in auto mode when its key is set. Never commit real keys.
# POA_GEMINI_API_KEY=
# POA_GEMINI_API_KEY_2=  # Optional reserve for invalid/expired keys, not quota rotation.
# POA_GEMINI_MODEL=gemini-3.1-flash-lite
# POA_COPILOT_PROVIDER=auto
# Split deployment only: Daytona serves UI; API runs behind a private edge token.
POA_FRONTEND_ONLY=false
# POA_ORIGIN_PROXY_TOKEN=generate-a-separate-long-random-secret-on-the-backend

# Wallet-signed test-SOL features; both RPCs are checked against Devnet genesis
POA_ADAPTIVE_DEVNET_PAYMENTS_ENABLED=false
POA_ADAPTIVE_DEVNET_DEX_ENABLED=false
